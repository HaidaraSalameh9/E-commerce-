# ------------------------------------------------------------------
# Frontend (Vite) - copy the values you use into `.env` locally,
# and add the same keys in your host's environment settings.
# ------------------------------------------------------------------

# Clerk publishable key for the frontend (pk_test_... for the dev instance,
# pk_live_... for a production instance).
VITE_CLERK_PUBLISHABLE_KEY=

# Firebase web app config (Project settings -> Your apps -> Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base URL of the deployed Cloud Functions API, no trailing slash.
# Leave empty during local development to use the Firebase emulator
# (http://127.0.0.1:5001/e-commerce-app-717a6/us-central1).
VITE_API_BASE_URL=https://us-central1-e-commerce-app-717a6.cloudfunctions.net

# ------------------------------------------------------------------
# Backend (functions/.env - never committed)
# CLERK_JWT_KEY, CLERK_SECRET_KEY  -> set with:
#   firebase functions:secrets:set CLERK_JWT_KEY
#   firebase functions:secrets:set CLERK_SECRET_KEY
# OWNER_CLERK_USER_ID              -> Clerk user id of the owner account
# ALLOWED_ORIGINS                  -> comma separated frontend origins,
#                                     used for CORS and Clerk authorizedParties
#   ALLOWED_ORIGINS=https://your-app.vercel.app,https://www.your-domain.com
# ------------------------------------------------------------------
